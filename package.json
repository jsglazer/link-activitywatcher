{
	"name": "link-activitywatcher",
	"version": "1.0.1",
	"description": "Send Obsidian note activity (vault, file, language) to a local ActivityWatch server as an editor watcher.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit -p tsconfig.json && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": ["obsidian", "plugin", "activitywatch", "time-tracking", "watcher"],
	"author": "Josh Glazer",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^25.9.3",
		"esbuild": "0.28.1",
		"obsidian": "latest",
		"tslib": "2.8.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	}
}
